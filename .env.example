APP_NAME=TITAN X
APP_VERSION=0.1.0
APP_BUILD_DATE=
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://titan_x:change-me@postgres:5432/titan_x
REDIS_URL=redis://:change-me@redis:6379/0
API_KEY=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
DOCS_ENABLED=true
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Market data: Angel One SmartAPI
MARKET_DATA_PROVIDER=angelone
ANGEL_ONE_API_KEY=replace-with-your-angel-one-smartapi-api-key
ANGEL_ONE_CLIENT_ID=replace-with-your-angel-one-client-id
ANGEL_ONE_PIN=replace-with-your-angel-one-pin
ANGEL_ONE_TOTP_SECRET=replace-with-your-angel-one-totp-secret
MARKET_DATA_INGEST_ON_STARTUP=true
MARKET_DATA_INGEST_MAX_SYMBOLS=20
PAPER_DEMO_PRICES=false

# JWT
JWT_SECRET_KEY=replace-with-another-long-random-secret-at-least-64-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# MFA
MFA_ENCRYPTION_KEY=replace-with-a-fernet-key

# QR + smartphone SMS verification
QR_SMS_NUMBER=+10000000000
QR_SMS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Security: Trusted Hosts
TRUSTED_HOSTS=localhost,127.0.0.1,api.titanx.local
ENABLE_HTTPS_REDIRECT=false

# Security: Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Security: Brute Force Protection
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW_MINUTES=15
BRUTE_FORCE_BLOCK_MINUTES=30

# Redis Cache
CACHE_DEFAULT_TTL=300
SESSION_TTL=3600

# Background Task Queue
TASK_QUEUE_ENABLED=true
TASK_QUEUE_POLL_INTERVAL=1
TASK_QUEUE_MAX_RETRIES=3

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=15
JOB_DEFAULT_MAX_RETRIES=3
JOB_DEFAULT_RETRY_DELAY=60

# Database backups
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_S3_PREFIX=titan-x-backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
