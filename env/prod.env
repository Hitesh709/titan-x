APP_NAME=TITAN X
APP_VERSION=0.1.0
APP_BUILD_DATE=
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database — SQLite only
DATABASE_URL=sqlite+aiosqlite:///./titan_x.db
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# API Security
API_KEY=${API_KEY}
CORS_ORIGINS=https://app.titanx.io,https://admin.titanx.io
DOCS_ENABLED=false
SQL_ECHO=false

# JWT
JWT_SECRET_KEY=${JWT_SECRET_KEY}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Security: Trusted Hosts
TRUSTED_HOSTS=api.titanx.io,localhost,127.0.0.1
ENABLE_HTTPS_REDIRECT=true

# Security: Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Security: Brute Force Protection
BRUTE_FORCE_MAX_ATTEMPTS=3
BRUTE_FORCE_WINDOW_MINUTES=15
BRUTE_FORCE_BLOCK_MINUTES=60

# Redis Cache
CACHE_DEFAULT_TTL=300

# Redis Session Store
SESSION_TTL=900

# Background Task Queue
TASK_QUEUE_ENABLED=true
TASK_QUEUE_POLL_INTERVAL=1
TASK_QUEUE_MAX_RETRIES=3
RUN_WORKER_IN_PROCESS=true

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=15
JOB_DEFAULT_MAX_RETRIES=3
JOB_DEFAULT_RETRY_DELAY=60

# Uvicorn
UVICORN_WORKERS=1
UVICORN_LIMIT_CONCURRENCY=1024
UVICORN_BACKLOG=2048
