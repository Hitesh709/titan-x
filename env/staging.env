APP_NAME=TITAN X
APP_VERSION=0.1.0
APP_BUILD_DATE=
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000

# Database (SQLite-only)
DATABASE_URL=sqlite+aiosqlite:///./titan_x_staging.db
# Local Docker/Compose Redis (Render injects its service URL where applicable).
REDIS_URL=redis://redis:6379/1

# API Security
API_KEY=${API_KEY}
CORS_ORIGINS=https://staging.app.titanx.io
DOCS_ENABLED=true
SQL_ECHO=true

# JWT
JWT_SECRET_KEY=${JWT_SECRET_KEY}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# Security: Trusted Hosts
TRUSTED_HOSTS=staging.api.titanx.io,localhost,127.0.0.1
ENABLE_HTTPS_REDIRECT=true

# Security: Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# Security: Brute Force Protection
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW_MINUTES=15
BRUTE_FORCE_BLOCK_MINUTES=30

# Redis Cache
CACHE_DEFAULT_TTL=300

# Redis Session Store
SESSION_TTL=3600

# Background Task Queue
TASK_QUEUE_ENABLED=true
TASK_QUEUE_POLL_INTERVAL=1
TASK_QUEUE_MAX_RETRIES=3

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=15
JOB_DEFAULT_MAX_RETRIES=3
JOB_DEFAULT_RETRY_DELAY=60

# In-process worker
RUN_WORKER_IN_PROCESS=true

# Uvicorn
UVICORN_WORKERS=1
UVICORN_LIMIT_CONCURRENCY=512
UVICORN_BACKLOG=1024
