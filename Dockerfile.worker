FROM python:3.13-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

COPY requirements.txt .
RUN pip install --user --no-warn-script-location -r requirements.txt

COPY src ./src
RUN python -m compileall -q src

FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN addgroup --system titan && adduser --system --ingroup titan titan && \
    apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/.local /root/.local
COPY --from=builder /build/src ./src

USER titan

LABEL org.opencontainers.image.title="TITAN X Worker" \
      org.opencontainers.image.description="Background worker for TITAN X" \
      org.opencontainers.image.version="0.1.0"

CMD ["python", "-m", "titan_x.infrastructure.task_queue"]
